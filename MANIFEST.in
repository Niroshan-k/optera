include README.md
include LICENSE
include pyproject.toml
recursive-include optera *.py
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.ipynb
global-exclude *.csv
global-exclude *.json
global-exclude *.pdf

# Include C++ source and header files for cross-platform builds
recursive-include optera *.cpp *.hpp *.h CMakeLists.txt
